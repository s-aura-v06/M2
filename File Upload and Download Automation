package automation;

import java.awt.Robot;
import java.awt.Toolkit;
import java.awt.datatransfer.StringSelection;
import java.awt.event.KeyEvent;
import java.io.File;
import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.chrome.ChromeOptions;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

public class FileUploadDownload {

    public static void main(String[] args) throws Exception {

        // CHROME SETUP

        String downloadPath =
                System.getProperty("user.home") + "\\Downloads";

        File oldFile =
                new File(downloadPath + "\\testfile.txt");

        if (oldFile.exists()) {
            oldFile.delete();
        }

        ChromeOptions options = new ChromeOptions();

        options.addArguments("--disable-notifications");

        options.setExperimentalOption(
                "prefs",
                java.util.Map.of(
                        "download.default_directory", downloadPath,
                        "download.prompt_for_download", false,
                        "download.directory_upgrade", true,
                        "safebrowsing.enabled", true
                )
        );

        WebDriver driver = new ChromeDriver(options);

        driver.manage().window().maximize();

        WebDriverWait wait =
                new WebDriverWait(driver, Duration.ofSeconds(10));

        try {

            // OPEN HTML PAGE

            driver.get(
                    "file:///C:/Automation/upload_download.html"
            );

            System.out.println("Web page opened successfully.");

            // FILE UPLOAD

            System.out.println("\nStarting file upload...");

            JavascriptExecutor js =
                    (JavascriptExecutor) driver;

            js.executeScript(
                    "document.getElementById('uploadFile').click();"
            );

            String filePath =
                    "C:\\Automation\\testfile.txt";

            StringSelection selection =
                    new StringSelection(filePath);

            Toolkit.getDefaultToolkit()
                    .getSystemClipboard()
                    .setContents(selection, null);

            // ROBOT CLASS

            Robot robot = new Robot();

            robot.delay(1000);

            robot.keyPress(KeyEvent.VK_CONTROL);
            robot.keyPress(KeyEvent.VK_V);

            robot.keyRelease(KeyEvent.VK_V);
            robot.keyRelease(KeyEvent.VK_CONTROL);

            robot.delay(500);

            robot.keyPress(KeyEvent.VK_ENTER);
            robot.keyRelease(KeyEvent.VK_ENTER);

            robot.delay(1000);

            System.out.println(
                    "File selected using Robot Class."
            );

            // VALIDATE UPLOAD

            String uploadMessage =
                    wait.until(
                            ExpectedConditions.visibilityOfElementLocated(
                                    By.id("uploadStatus")
                            )
                    ).getText();

            System.out.println(
                    "Upload Result: " + uploadMessage
            );

            if (uploadMessage.contains("testfile.txt")) {

                System.out.println("UPLOAD SUCCESSFUL");

            } else {

                System.out.println("UPLOAD FAILED");
            }

            // FILE DOWNLOAD

            System.out.println("\nStarting file download...");

            driver.findElement(
                    By.id("downloadButton")
            ).click();

            System.out.println("Download button clicked.");

            // WAIT FOR DOWNLOAD

            File downloadedFile =
                    new File(downloadPath + "\\testfile.txt");

            int waitTime = 0;

            while (!downloadedFile.exists() && waitTime < 10) {

                Thread.sleep(1000);
                waitTime++;
            }

            // VALIDATE DOWNLOAD

            if (downloadedFile.exists()) {

                System.out.println("Downloaded file found:");

                System.out.println(
                        downloadedFile.getAbsolutePath()
                );

                System.out.println("DOWNLOAD SUCCESSFUL");

            } else {

                System.out.println("DOWNLOAD FAILED");

                System.out.println(
                        "File was not found in Downloads folder."
                );
            }

        } finally {

            driver.quit();

            System.out.println("\nAutomation completed.");
        }
    }
}
